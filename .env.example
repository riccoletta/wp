# Questo file si copia in `.env`. Le variabili già presenti nell'ambiente vincono.
#
# Tre ambienti, tre insiemi di variabili che NON si mescolano:
#   1. il frontend (Vercel)         → solo VITE_*
#   2. gli strumenti del database   → solo DATABASE_URL / MIGRATION_DATABASE_URL
#   3. le Edge Function (Supabase)  → segreti di Edge Function, mai qui e mai su Vercel

# --- 1. Frontend (Vercel: Environment Variables del progetto) ----------------
# Le uniche due variabili che servono all'applicazione distribuita. La chiave
# pubblicabile è pubblica per costruzione: non concede permessi, dà accesso a
# PostgREST come ruolo `anon`, che nel nostro schema non può leggere nulla. Tutto
# ciò che si vede dopo il login lo decide la RLS a partire da `auth.uid()`.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# MAI nel frontend: la chiave di servizio (service role) e qualsiasi credenziale
# PostgreSQL. Scavalcano la RLS e aprono l'intero database a chiunque apra il sito.

# --- 2. Strumenti del database (solo sul computer di chi amministra) ---------
# Servono a `npm run migrate`, `npm run db:verify`, `npm run admin:bootstrap`,
# `npm run seed`. Non vanno su Vercel: il frontend non parla con PostgreSQL.
# Su Supabase conviene la connessione DIRETTA (porta 5432) del ruolo proprietario.
DATABASE_URL=
# Connessione usata SOLO da `npm run migrate`. Se vuota si usa DATABASE_URL.
MIGRATION_DATABASE_URL=
# Database locale PGlite per sviluppo e test (ignorato se DATABASE_URL è valorizzata).
PGLITE_DIR=./db/data
# TLS: vuoto = verifica piena con le CA di sistema. `no-verify` sconsigliato.
DATABASE_SSL=
# CA aggiuntiva: PEM inline, base64, o percorso di un file .crt. Supabase firma con
# una CA propria: scaricala dal pannello (Database → SSL) e indicala qui.
DATABASE_CA_CERT=
# Connessioni per istanza e timeout di sicurezza delle query (ms, default 15000).
DATABASE_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=
# Migrazioni all'avvio: no. Si lanciano con `npm run migrate`, come atto separato.
AUTO_MIGRATE=false
# Consente `npm run seed` (dati dimostrativi) anche con DATABASE_URL impostata.
# Mai `true` in produzione.
ALLOW_DEMO_SEED=false

# --- 3. Segreti delle Edge Function (pannello Supabase, non questo file) -----
# Si impostano con `supabase secrets set`, oppure da Dashboard → Edge Functions →
# Secrets. Qui restano solo come promemoria dei nomi.
#
#   LICENSE_OWNER_TOKEN   token di servizio del PROPRIETARIO del software: abilita
#                         la Edge Function `license-owner` (rinnovo, sospensione,
#                         riattivazione). Nessun ruolo applicativo, admin del club
#                         compreso, può modificare la licenza. Se vuoto, canale chiuso.
#   APP_SITE_URL          dominio pubblico dell'applicazione, dove atterrano i link
#                         di invito e di recupero password (es. https://club.vercel.app).
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY le fornisce Supabase
# alle funzioni: non vanno impostate a mano e non escono da lì.

# --- Prove end-to-end (ambiente Supabase DI PROVA, mai produzione) -----------
# E2E_PASSWORD=
# E2E_LICENSE_FUNCTION_URL=
