# Questo file si copia in `.env`: il server lo legge da solo (loader di Node).
# Le variabili già presenti nell'ambiente vincono sul file.

# Porta dell'API
PORT=3000

# --- Database ---------------------------------------------------------------
# Postgres gestito (Supabase o altro). Se vuoto si usa PGlite su file, in db/data.
# Supabase, Transaction Pooler (consigliato per Vercel / serverless), porta 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<regione>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Connessione usata SOLO da `npm run migrate`. Su Supabase conviene la connessione
# diretta (porta 5432), non il pooler. Se vuota si usa DATABASE_URL.
MIGRATION_DATABASE_URL=
# Percorso del database locale PGlite (ignorato se DATABASE_URL è valorizzata)
PGLITE_DIR=./db/data
# TLS: vuoto = verifica piena con le CA di sistema.
# `disable` solo per un Postgres locale; `no-verify` sconsigliato.
DATABASE_SSL=
# CA aggiuntiva: PEM inline oppure percorso di un file .crt (anche assoluto).
# Supabase firma con una CA propria: scaricala dal pannello (Database → SSL) e
# indicala qui, altrimenti la verifica piena fallisce con SELF_SIGNED_CERT_IN_CHAIN.
DATABASE_CA_CERT=
# Connessioni per istanza: 1 in serverless, 10 su un processo stabile.
DATABASE_POOL_MAX=
# Timeout di sicurezza delle query, in millisecondi (default 15000)
DATABASE_STATEMENT_TIMEOUT_MS=
# Migrazioni all'avvio dell'API su Postgres gestito: NO. Si lanciano con
# `npm run migrate`, altrimenti due istanze migrano insieme. `true` solo se serve.
AUTO_MIGRATE=false
# Consente `npm run seed` (dati dimostrativi) anche con DATABASE_URL impostata.
# Mai `true` in produzione.
ALLOW_DEMO_SEED=false

# --- Applicazione -----------------------------------------------------------
# Cookie di sessione su HTTPS soltanto (impostare a true in produzione)
COOKIE_SECURE=false
# Origine del frontend ammessa in sviluppo
WEB_ORIGIN=http://localhost:5173
# Token di servizio del PROPRIETARIO del software: abilita /api/owner/license
# (rinnovo, sospensione, riattivazione). Se vuoto il canale è chiuso.
# Nessun ruolo applicativo, admin del club compreso, può modificare la licenza.
LICENSE_OWNER_TOKEN=
