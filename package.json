{
  "name": "pallanuoto-gestionale",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "check": "npm run check --workspace=server && npm run check --workspace=web && tsc --noEmit",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "migrate": "npm run migrate --workspace=server",
    "db:verify": "npm run db:verify --workspace=server",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=server --",
    "e2e": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
