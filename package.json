{
  "name": "pallanuoto-gestionale",
  "private": true,
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "check": "npm run check --workspace=server && npm run check --workspace=web",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "migrate": "npm run migrate --workspace=server"
  }
}
